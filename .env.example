# Skopíruj tento súbor ako ".env.local" pre lokálne testovanie, alebo
# (odporúčané pre ostrú prevádzku) vlož tieto isté hodnoty priamo do
# Vercel -> Project Settings -> Environment Variables. Skutočné heslá
# a kľúče sem do repozitára NIKDY nepatria — súbor .env.local je preto
# v .gitignore a Git ho nikdy neuloží.

# Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# E-maily, ktoré smú do správy webu (/admin/). Viac adries oddel čiarkou.
# Musí sedieť s e-mailom, ktorým sa prihlasuješ — teda s používateľom
# založeným v Supabase -> Authentication -> Users.
# Keď zostane prázdna, do správy sa nedostane NIKTO. Je to zámer:
# prihlásenie samo o sebe nestačí, lebo účet si vie v Supabase založiť
# aj cudzí človek.
ADMIN_EMAILS=

# Prihlasovacie údaje k tvojej e-mailovej schránke (Websupport),
# používajú sa na automatické odoslanie notifikácie o novej objednávke.
SMTP_HOST=smtp.m1.websupport.sk
SMTP_PORT=465
SMTP_USER=kolacik@dosrdiecka.sk
SMTP_PASSWORD=
